# Frontend
VITE_API_URL=https://your-backend-domain.vercel.app/api/v1

# Backend
APP_NAME=PianoFlow API
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./pianoflow.db
AUTO_CREATE_TABLES=true
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_SEED_USERNAME=admin
AUTH_SEED_PASSWORD=admin12345
AUTH_SEED_ROLE=admin
AUTH_COOKIE_SECURE=false

# Optional AI
LLM_ENABLED=false
LLM_BASE_URL=https://your-router.example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45

# Supabase / managed PostgreSQL example
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
# AUTO_CREATE_TABLES=false
# AUTH_COOKIE_SECURE=true
