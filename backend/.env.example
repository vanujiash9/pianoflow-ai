APP_NAME=PianoFlow API

# Local development
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production on Render or another public host
# ENVIRONMENT=production
# DEBUG=false
# CORS_ORIGINS=https://your-vercel-app.vercel.app

# Supabase / managed PostgreSQL.
DATABASE_URL=
AUTO_CREATE_TABLES=false

# Example:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

# Local SQLite is intentionally not the default anymore.
# If you need it for quick local tests, set it manually in .env.
# DATABASE_URL=sqlite:///./pianoflow.db
# AUTO_CREATE_TABLES=true
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Authentication
AUTH_SECRET=
AUTH_SEED_USERNAME=
AUTH_SEED_PASSWORD=
AUTH_SEED_ROLE=admin
AUTH_COOKIE_SECURE=false

# OpenAI-compatible router/gateway
LLM_ENABLED=false
LLM_BASE_URL=https://your-router.example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45

