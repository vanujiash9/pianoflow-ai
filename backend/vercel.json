{
  "version": 2,
  "services": {
    "pianoflow-api": {
      "root": ".",
      "runtime": "python",
      "entrypoint": "api/index.py"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "pianoflow-api"
      }
    }
  ]
}
